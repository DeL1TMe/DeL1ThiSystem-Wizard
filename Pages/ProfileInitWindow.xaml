<Window x:Class="DeL1ThiSystem.ConfigurationWizard.Pages.ProfileInitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="#EE000000">
    <Grid>
        <Border x:Name="ProgressCard"
                Width="760"
                MinHeight="220"
                Background="#FF111827"
                BorderBrush="#FF2B3A55"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Подготавливаем профиль пользователя"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"
                           TextAlignment="Center"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding CurrentStepText}"
                           Foreground="#D0D7E2"
                           FontSize="15"
                           Margin="0,0,0,16"
                           TextAlignment="Center"/>

                <Grid Grid.Row="2" Height="16" Width="700">
                    <Border Background="#243247" CornerRadius="6"/>
                    <Border Background="#0078D4"
                            CornerRadius="6"
                            HorizontalAlignment="Left"
                            Width="{Binding ProgressWidth}"/>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="{Binding PercentText}"
                           Foreground="#D0D7E2"
                           FontSize="14"
                           Margin="0,12,0,0"
                           TextAlignment="Center"/>

                <Border x:Name="InternetRequiredOverlay"
                        Grid.RowSpan="4"
                        Visibility="Collapsed"
                        Opacity="0"
                        Background="#99111827"
                        CornerRadius="12"
                        Panel.ZIndex="20">
                    <Grid>
                        <Border Width="520"
                                Padding="24,20"
                                CornerRadius="12"
                                Background="#B2141E2E"
                                BorderBrush="#663F8CFF"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Foreground="#FFFFFF"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="Требуется подключение к интернету"
                                           TextAlignment="Center"/>
                                <TextBlock Foreground="#D0D7E2"
                                           FontSize="15"
                                           Margin="0,10,0,14"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Text="Для продолжения настройки требуется доступ к интернету.
                                           Офлайн сетевой драйвер доступен в папке «3DP» на рабочем столе."/>
                                <TextBlock x:Name="InternetRequiredText"
                                           Foreground="#D0D7E2"
                                           FontSize="32"
                                           FontWeight="SemiBold"
                                           Text="Ожидаем сеть..."
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
