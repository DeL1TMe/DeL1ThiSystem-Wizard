<Window x:Class="DeL1ThiSystem.ConfigurationWizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeL1ThiSystem Configuration Wizard"
        Width="720" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>


    <Grid x:Name="RootGrid" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Viewbox x:Name="WindowScaler"
                 Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Border x:Name="WindowShell"
                    Width="720"
                    Height="800"
                    CornerRadius="14"
                    Background="{DynamicResource Brush.WindowBorder}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border x:Name="WindowCard"
                        CornerRadius="13"
                        Background="{DynamicResource Brush.WindowBg}"
                        Margin="1"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                <Grid>
                <Grid x:Name="MainContent" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

            <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="HeaderLogo"
                       Width="290" Height="80"
                       HorizontalAlignment="Left"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Button x:Name="HeaderCloseButton"
                        Grid.Column="1"
                        Style="{StaticResource ButtonHeaderClose}"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.CardBg}"
                    CornerRadius="16"
                    Padding="0">
                <Frame x:Name="Frame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>

            </Grid>
            </Border>

        <Grid x:Name="InternetRequiredOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              ClipToBounds="True"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Border x:Name="InternetRequiredBackdrop"
                    Background="{DynamicResource Brush.ModalBackdrop}"
                    CornerRadius="14"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"/>
            <Border Background="{DynamicResource Brush.PopupBorder}"
                    CornerRadius="12"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.PopupBg}"
                        CornerRadius="11"
                        Margin="1"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}"
                                   Text="Требуется подключение к интернету"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextBody}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Opacity="0.88"
                                   Margin="0,10,0,14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Для продолжения настройки требуется доступ к интернету.
                                   Офлайн сетевой драйвер доступен в папке «3DP» на рабочем столе."/>
                        <TextBlock x:Name="InternetRequiredBlinkText"
                                   Style="{StaticResource TextBody}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Opacity="0.95"
                                   Text="Ожидаем сеть..."
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <Grid x:Name="ExitConfirmOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              ClipToBounds="True"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Border Background="{DynamicResource Brush.ModalBackdrop}"
                    CornerRadius="14"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"/>
            <Border Background="{DynamicResource Brush.PopupBorder}"
                    CornerRadius="12"
                    Width="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.CardBg}"
                        CornerRadius="11"
                        Margin="1"
                        Padding="24">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="Вы действительно хотите выйти?"/>
                    <TextBlock Style="{StaticResource TextBody}" Margin="0,10,0,18"
                               Text="Мы настоятельно рекомендуем завершить настройку сейчас.
                               Внесение изменений в систему помешает настроить её повторно."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource ButtonSecondary}" Opacity="0.88"
                                Height="34" MinHeight="34" Padding="18,0"
                                Margin="0,0,10,0" Click="ExitConfirmCancel_Click"/>
                        <Button Content="Выйти" Style="{StaticResource ButtonPrimary}"
                                Height="34" MinHeight="34" Padding="18,0"
                                Click="ExitConfirmExit_Click"/>
                    </StackPanel>
                </StackPanel>
                </Border>
            </Border>
            </Grid>
            </Grid>
            </Border>
        </Viewbox>
    </Grid>
</Window>
